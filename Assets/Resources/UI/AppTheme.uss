:root {
    --bg: #0b1c33;
    --bg-elevated: #122846;
    --bg-card: #17345a;
    --bg-card-alt: #1c3f6b;
    --stroke: #2b527f;
    --text: #f4f7fb;
    --text-muted: #a9bdd6;
    --accent: #f5c542;
    --accent-dark: #d4a017;
    --success: #3ecf8e;
    --danger: #ff6b6b;
    --info: #4da3ff;
    --radius: 16px;
    --nav-height: 72px;
    --pad: 16px;
}

* {
    -unity-font-style: normal;
}

.screen-root {
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    padding: 0;
    margin: 0;
}

.safe-area {
    flex-grow: 1;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 8px;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.header-title {
    font-size: 24px;
    color: var(--text);
    -unity-font-style: bold;
}

.header-subtitle {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 2px;
}

.scroll {
    flex-grow: 1;
    overflow: scroll;
}

.card {
    background-color: var(--bg-card);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--stroke);
    padding: 14px;
    margin-bottom: 12px;
}

.card-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
    margin-bottom: 6px;
}

.card-body {
    font-size: 13px;
    color: var(--text-muted);
    white-space: normal;
}

.row {
    flex-direction: row;
    align-items: center;
}

.row-spread {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.chip {
    background-color: var(--bg-card-alt);
    border-radius: 999px;
    padding: 6px 10px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--stroke);
    font-size: 12px;
    color: var(--text);
}

.chip-accent {
    background-color: var(--accent);
    color: #1a1300;
    border-color: var(--accent-dark);
    -unity-font-style: bold;
}

.badge {
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: var(--info);
    color: white;
}

.badge-beginner { background-color: #3ecf8e; }
.badge-junior { background-color: #4da3ff; }
.badge-mid { background-color: #f5c542; color: #1a1300; }
.badge-senior { background-color: #ff9f43; }
.badge-lead { background-color: #ff6b6b; }

.btn {
    background-color: var(--accent);
    color: #1a1300;
    border-radius: 12px;
    padding: 12px 16px;
    -unity-font-style: bold;
    font-size: 14px;
    border-width: 0;
    margin-top: 8px;
}

.btn:hover { background-color: rgb(247, 210, 100); }
.btn:active { background-color: var(--accent-dark); }

.btn-secondary {
    background-color: var(--bg-card-alt);
    color: var(--text);
    border-width: 1px;
    border-color: var(--stroke);
}

.btn-danger {
    background-color: var(--danger);
    color: white;
}

.btn-ghost {
    background-color: rgba(0,0,0,0);
    color: var(--accent);
    border-width: 0;
    -unity-font-style: bold;
}

.btn-small {
    padding: 8px 12px;
    font-size: 12px;
    margin-top: 0;
    margin-right: 8px;
}

.field {
    background-color: var(--bg-elevated);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--stroke);
    color: var(--text);
    padding: 10px;
    margin-bottom: 10px;
}

.progress-track {
    height: 10px;
    background-color: var(--bg-elevated);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 8px;
    margin-bottom: 8px;
}

.progress-fill {
    height: 10px;
    background-color: var(--accent);
    width: 40%;
}

.nav-bar {
    height: var(--nav-height);
    background-color: var(--bg-elevated);
    border-top-width: 1px;
    border-top-color: var(--stroke);
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.nav-item {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 8px 4px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--text-muted);
    font-size: 11px;
}

.nav-item-active {
    color: var(--accent);
    -unity-font-style: bold;
}

.muted {
    color: var(--text-muted);
    font-size: 12px;
}

.timer {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
    margin: 12px 0;
}

.code-block {
    background-color: #0a1524;
    border-radius: 10px;
    padding: 10px;
    margin-top: 8px;
    margin-bottom: 8px;
    color: #d7e6ff;
    font-size: 12px;
    white-space: normal;
}

.empty {
    -unity-text-align: middle-center;
    color: var(--text-muted);
    margin-top: 40px;
    font-size: 14px;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-top: 8px;
    margin-bottom: 8px;
}

.flash-card {
    min-height: 220px;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-card);
    border-radius: 20px;
    border-width: 2px;
    border-color: var(--accent);
    padding: 20px;
    margin: 12px 0;
}

.flash-text {
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--text);
}

.logo {
    width: 160px;
    height: 160px;
    align-self: center;
    margin: 24px 0 12px 0;
}

.splash-title {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text);
}

.splash-sub {
    font-size: 14px;
    -unity-text-align: middle-center;
    color: var(--accent);
    margin-top: 6px;
    margin-bottom: 20px;
}

.hidden { display: none; }

.list-button {
    background-color: var(--bg-card);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--stroke);
    padding: 12px;
    margin-bottom: 10px;
    color: var(--text);
}

.list-button:hover {
    border-color: var(--accent);
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-cell {
    width: 48%;
    background-color: var(--bg-card);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--stroke);
    padding: 12px;
    margin-right: 2%;
    margin-bottom: 10px;
}

.stat-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--accent);
}

.stat-label {
    font-size: 11px;
    color: var(--text-muted);
}
